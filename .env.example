VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_RSVP_OPEN_AT=
VITE_RSVP_CLOSE_AT=
# Vercel-only (NOT VITE_ exposed):
#   SUPABASE_SERVICE_ROLE_KEY  service_role key; full DB access, never expose
#   CRON_SECRET                bearer token for the /api/keepalive cron
#   RESEND_API_KEY             Resend API key
#   RESEND_EMAIL               sender address on the domain verified in Resend,
#                              e.g. noreply@mail.example.de
#   RSVP_WEBHOOK_SECRET        shared with the Supabase webhook's x-webhook-secret header
#   SITE_URL                   absolute site URL, so the email can load the lotus image
